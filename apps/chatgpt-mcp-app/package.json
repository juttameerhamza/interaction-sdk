{
  "name": "@interaction-sdk-example/chatgpt-mcp-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --raw \"cross-env NODE_ENV=development INPUT=mcp-app.html vite build --watch\" \"tsx watch main.ts\"",
    "build": "cross-env INPUT=mcp-app.html vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "echo no-tests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@interaction-sdk/components": "workspace:*",
    "@interaction-sdk/react": "workspace:*",
    "@interaction-sdk/testing": "workspace:*",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-query": "^5.80.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
