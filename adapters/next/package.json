{
  "name": "@interaction-sdk/adapter-next",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" }
  },
  "dependencies": {
    "@interaction-sdk/core": "workspace:*",
    "@interaction-sdk/adapter-browser": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.0",
    "next": ">=15 <17",
    "react": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@tanstack/react-query": "^5.80.0",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  }
}
